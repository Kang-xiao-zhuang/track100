<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/goal_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_icon_bg"
        android:gravity="center"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/goal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF2B2B2B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF7A7A7A"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/goal_add"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/widget_button_bg"
        android:minWidth="52dp"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
